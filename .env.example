OPENAI_API_KEY=tu_api_key
OPENAI_MODEL=gpt-4.1-mini
API_URL=http://127.0.0.1:8000
CORS_ALLOW_ORIGINS=*
LLM_PROVIDER=openai
LLM_MODEL=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=
DEEPSEEK_API_KEY=
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
PRODUCT_NAME=Tu Producto
SUPPORT_CONTACT=soporte@example.com | https://example.com/soporte
GLOSSARY_TITLE=Glosario de Terminos
GLOSSARY_URL=https://example.com/docs/glosario.html
ISSUE_CONTEXT_REQUEST=Para ayudarte necesito mas contexto del caso: describe que intentabas hacer, que ocurrio, cual fue el mensaje o comportamiento observado y que resultado esperabas. Si aplica, comparte tambien el identificador de la reserva, solicitud, transaccion o registro relacionado.
ESCALATION_REQUEST=Puedo dejar este caso listo para revision humana. Comparte por favor el contexto del caso, la accion realizada, el mensaje o comportamiento observado, tu usuario o correo de contacto y, si aplica, el identificador de la reserva, solicitud, transaccion o registro relacionado.
DOCS_ROOT_URL=
DOCS_SOURCE_DIR=
DOCS_ALLOWED_DOMAINS=
DOCS_PATH_PREFIX=/
DOCS_URL_SUFFIX=
DOCS_CONTENT_SELECTOR=article#content
DOCS_MAX_PAGES=40
RAG_INDEX_DIR=rag
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
MEMORI_ENABLED=false
MEMORI_PROCESS_ID=support-api
MEMORI_STORAGE_URL=sqlite:///app/data/memori.db
# MEMORI_API_KEY=tu_memori_api_key
# Idioma de los hechos extraídos (es|en); en inglés apenas se recuperan con consultas en español.
MEMORI_FACT_LANGUAGE=es
# true = llamadas síncronas de Memori en un hilo (no bloquean el bucle de eventos con varios usuarios).
MEMORI_OFFLOAD_SYNC=false
# Pool de conexiones de SQLite: null (por defecto) o queue (el de SQLAlchemy, se agota con ~15 peticiones simultáneas).
MEMORI_DB_POOL=null
# Atajos de la tubería (por defecto activos); la evaluación de memoria los apaga.
ISSUE_CONTEXT_ENABLED=true
ESCALATION_ENABLED=true
# Evaluación: EVAL_MODE=true añade "debug" a /chat (memorias, tokens, tiempos por etapa),
# acepta "eval_context" (condiciones C1/C2/C4) y habilita POST /eval/ingest.
EVAL_MODE=false
# Caché JSONL de extracción de hechos (solo con EVAL_MODE); vacía = solo en memoria.
EVAL_EXTRACTION_CACHE=
# Perfil de prompt: support (agencia de viajes) o neutral (solo para la validación externa con LongMemEval).
EVAL_PROMPT_PROFILE=support

# Modelos de los scripts de evaluación (comentados = valores por defecto).
# Juez único, como en LongMemEval; usa DEEPSEEK_API_KEY. Admite varios separados por comas.
JUDGE_MODELS=deepseek:deepseek-v4-pro
# Generador del dataset, usuario simulado y detector de peticiones (por defecto gpt-6.1-terra).
# GENERATOR_MODEL=gpt-6.1-terra
# SIMULATOR_MODEL=gpt-6.1-terra
# DETECTOR_MODEL=gpt-6.1-terra
